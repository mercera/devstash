# Neon PostgreSQL
#
# Both come from the Neon dashboard for the branch you are working on:
# development locally, production on the deployed environment.
#
# DATABASE_URL — pooled connection ("-pooler" in the host). Used by the app at
#                runtime through the Neon driver adapter.
# DIRECT_URL   — direct connection (no "-pooler"). Used by the Prisma CLI for
#                migrations and by the shadow database.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Context7 MCP
#
# `.mcp.json` reads this as ${CONTEXT7_API_KEY}. MCP config is expanded from the
# real process environment, not from this file — set it in your shell (or your
# editor's env) before starting Claude Code, not just here. Key from context7.com.

CONTEXT7_API_KEY="ctx7sk-..."
