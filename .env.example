# Neon PostgreSQL
#
# Both come from the Neon dashboard for the branch you are working on:
# development locally, production on the deployed environment.
#
# DATABASE_URL — pooled connection ("-pooler" in the host). Used by the app at
#                runtime through the Neon driver adapter.
# DIRECT_URL   — direct connection (no "-pooler"). Used by the Prisma CLI for
#                migrations and by the shadow database.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Auth.js (NextAuth v5)
#
# AUTH_SECRET        — encrypts the session JWT. Generate one with
#                      `npx auth secret`, or
#                      `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# AUTH_GITHUB_ID     — GitHub OAuth app client id.
# AUTH_GITHUB_SECRET — GitHub OAuth app client secret.
#
# Register the OAuth app at https://github.com/settings/developers with the
# callback URL http://localhost:3000/api/auth/callback/github for local dev.
# The GitHub provider picks these up by name — no clientId/clientSecret is
# passed in `src/auth.config.ts`.

AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Seed data
#
# SEED_DEMO_PASSWORD — password for the seeded demo account
#                      (demo@devstash.io). Optional: leave it unset and
#                      `npm run db:seed` generates a random one and prints it
#                      once. Set it to keep the same login across re-seeds.
#                      Never commit a real value.

SEED_DEMO_PASSWORD=""

# Context7 MCP
#
# `.mcp.json` reads this as ${CONTEXT7_API_KEY}. MCP config is expanded from the
# real process environment, not from this file — set it in your shell (or your
# editor's env) before starting Claude Code, not just here. Key from context7.com.

CONTEXT7_API_KEY="ctx7sk-..."
